# Copy to .env.local and fill in from Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only secret. Never prefix with NEXT_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Comma-separated emails of superadmins (only they can manage users).
SUPERADMIN_EMAILS=ibryllen.atwork@gmail.com
# Set to "true" only after Google is enabled in Supabase (docs/supabase-setup.md section 6).
NEXT_PUBLIC_ENABLE_GOOGLE_SIGNIN=false
